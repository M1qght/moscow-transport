{
  "name": "moscow-transit-load",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @transit/api\" \"npm run dev -w @transit/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @transit/api",
    "test:e2e": "npm run test:e2e -w @transit/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "data:import": "tsx scripts/importTransport.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": { "@prisma/client": "6.19.0", "argon2": "^0.44.0", "dotenv": "^16.6.1", "zod": "^3.25.76" },
  "devDependencies": { "@types/node": "^22.19.0", "concurrently": "^9.2.1", "prisma": "6.19.0", "tsx": "^4.20.6", "typescript": "~5.9.3" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
